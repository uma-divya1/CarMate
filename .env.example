# Copy this file to .env and fill in your real TEST MODE keys.
# Never commit real keys — .env is already gitignored.

# From the Razorpay Dashboard -> Settings -> API Keys (make sure "Test Mode" is on)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx

# From console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-sonnet-4-6

FLASK_SECRET_KEY=change-this-to-something-random
